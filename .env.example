# ─────────────────────────────────────────────────────────────
# CareerLens AI — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` to source control.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Database
# Local development (SQLite — zero setup):
DATABASE_URL="file:./careerlens.db"
# Production (PostgreSQL — e.g. Supabase / Neon):
# DATABASE_URL="postgresql://user:password@host:5432/careerlens?sslmode=require"

# Auth
# 32+ char random secret used to sign session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Session lifetime in seconds (default 7 days = 604800)
SESSION_TTL_SECONDS=604800

# AI provider (optional — the app falls back to a deterministic engine if unset)
# OpenAI-compatible Chat Completions endpoint (OpenAI, OpenRouter, Groq, etc.)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
# Optional: keep your key on the server only. Never expose to the frontend.

# Resume storage directory (relative to project root)
RESUME_UPLOAD_DIR="./uploads"
# Max resume upload size in bytes (5 MB)
MAX_UPLOAD_BYTES=5242880

# Rate limiting (requests per window per IP for auth endpoints)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
